# Copy to .env — never commit .env
# Tier-2 generation server (Magellano). From inside Docker use host.docker.internal or the LAN address.
MAGELLANO_URL=http://host.docker.internal:8004
MAGELLANO_TIMEOUT=240.0
MAGELLANO_HEALTH_TIMEOUT=1.5
MAGELLANO_HEALTH_TTL=10.0
# Directory shared with Magellano for PDF page images (optional)
MAGELLANO_VISUAL_ASSET_ROOT=

# RAG limits
RAG_MAX_RETRIEVAL_CHUNKS=120
RAG_DEFAULT_RETRIEVAL_CHUNKS=48
RAG_GENERATION_CONTEXT_CHUNKS=96
RAG_MAX_TOKENS=49152
RAG_DEFAULT_MAX_TOKENS=12288

# CORS: comma-separated origins (default "*" is for local development only)
# ALLOWED_ORIGINS=http://localhost:5678

# n8n (basic auth)
# N8N_AUTH_ACTIVE=true
# N8N_AUTH_USER=admin
# N8N_AUTH_PASSWORD=change-me

# Semantic Scholar API key (free: https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=
